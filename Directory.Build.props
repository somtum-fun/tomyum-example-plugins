<Project>
  <!--
    Where TomYum.Plugins.Abstractions comes from. By default, a TomYum-OSS checkout next to this repo
    (git clone https://github.com/somtum-fun/TomYum-OSS ../TomYum-OSS). Point it elsewhere with
    dotnet build -p:TomYumRoot=/path/to/TomYum-OSS
  -->
  <PropertyGroup>
    <TomYumRoot Condition="'$(TomYumRoot)' == ''">$(MSBuildThisFileDirectory)../TomYum-OSS</TomYumRoot>
    <TomYumAbstractions>$(TomYumRoot)/src/TomYum.Plugins.Abstractions/TomYum.Plugins.Abstractions.csproj</TomYumAbstractions>
    <TomYumDomain>$(TomYumRoot)/src/TomYum.Domain/TomYum.Domain.csproj</TomYumDomain>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
